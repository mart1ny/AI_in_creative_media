, 12.397268414497375, 0.9434606992989486, 15.107280611991882, 2.710012197494507, 2.872416624781741, true], [\"edge\", 0.052689661261565456, 0.0038594413893861183, 0.02041684719302311, -0.03227281406854235, 8.362042796477253, true], [\"contrast\", 0.17502283087166942, 0.017087309880303346, 0.2574610307069266, 0.08243819983525719, 4.824527699956108, true], [\"seconds\", 25.42311448454857, 1.8006380477963964, 45.244078416749836, 19.820963932201266, 11.007744702750212, true]]\n\n{\n  \"variant\": 3,\n  \"pair\": [\n    \"turbo\",\n    \"amused\"\n  ],\n  \"rows\": [\n    [\n      \"clip_brief\",\n      25.16529530286789,\n      0.8040295537422786,\n      27.874488830566406,\n      2.709193527698517,\n      3.3695198330569256,\n      true\n    ],\n    [\n      \"clip_text\",\n      12.397268414497375,\n      0.9434606992989486,\n      15.107280611991882,\n      2.710012197494507,\n      2.872416624781741,\n      true\n    ],\n    [\n      \"edge\",\n      0.052689661261565456,\n      0.0038594413893861183,\n      0.02041684719302311,\n      -0.03227281406854235,\n      8.362042796477253,\n      true\n    ],\n    [\n      \"contrast\",\n      0.17502283087166942,\n      0.017087309880303346,\n      0.2574610307069266,\n      0.08243819983525719,\n      4.824527699956108,\n      true\n    ],\n    [\n      \"seconds\",\n      25.42311448454857,\n      1.8006380477963964,\n      45.244078416749836,\n      19.820963932201266,\n      11.007744702750212,\n      true\n    ]\n  ]\n}\n"
